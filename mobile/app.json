{
  "expo": {
    "name": "Saiyam",
    "slug": "saiyam-platform",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#D97706"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.trst.saiyam",
      "infoPlist": {
        "NSCameraUsageDescription": "Saiyam needs camera access to upload official school visit photos and logbook proofs.",
        "NSMicrophoneUsageDescription": "Saiyam needs microphone access to record session audio notes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D97706"
      },
      "package": "org.trst.saiyam",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
